# Remote state in S3 with native locking (OpenTofu >= 1.10). The state holds
# secrets (database password, generated keys): the bucket must be private and
# encrypted, with versioning on.
#
# 1. Create the bucket once, outside this configuration:
#      aws s3api create-bucket --bucket <name> --region ap-south-1 \
#        --create-bucket-configuration LocationConstraint=ap-south-1
#      aws s3api put-bucket-versioning --bucket <name> --versioning-configuration Status=Enabled
#      aws s3api put-public-access-block --bucket <name> --public-access-block-configuration \
#        BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true
# 2. Copy this file to backend.tf, fill in the bucket, and run `tofu init -migrate-state`.

terraform {
  backend "s3" {
    bucket       = "<state-bucket-name>"
    key          = "meet-ai/terraform.tfstate"
    region       = "ap-south-1"
    encrypt      = true
    use_lockfile = true
  }
}
