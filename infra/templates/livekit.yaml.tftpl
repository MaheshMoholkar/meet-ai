port: 7880
rtc:
  tcp_port: 7881
  udp_port: 7882
  use_external_ip: false
  # The Elastic IP: browsers, the agent (Fargate) and Egress all reach media here.
  node_ip: ${node_ip}
redis:
  address: localhost:6379
keys:
  ${api_key}: $${LIVEKIT_API_SECRET}
webhook:
  api_key: ${api_key}
  urls:
    - ${webhook_url}
room:
  empty_timeout: 60
  departure_timeout: 20
logging:
  level: info
