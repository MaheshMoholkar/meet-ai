# Copy to .env and fill in. Every variable is validated at startup by src/env.ts.

# Postgres from docker-compose.yml
DATABASE_URL="postgres://meetai:meetai@localhost:5432/meetai"

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Optional social login. A provider's button only appears when both of its values are set.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# LiveKit (docker-compose.yml). The server API is HTTP; browsers connect over WebSocket.
LIVEKIT_URL="http://localhost:7880"
LIVEKIT_PUBLIC_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
# At least 32 characters: openssl rand -hex 24
LIVEKIT_API_SECRET=""
LIVEKIT_AGENT_NAME="meet-agent"
# Global call-minute budget per UTC day. Prod: 30. Dev: anything large.
DAILY_BUDGET_MIN="1000"
RECORDING_ENABLED="true"

# AWS. Locally these point at the moto emulator from docker-compose.yml;
# in AWS, leave the endpoint and keys unset and use an IAM role.
AWS_REGION="us-east-1"
AWS_ENDPOINT_URL="http://localhost:4566"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
S3_BUCKET="meetai"
# Egress runs inside Docker and reaches the emulator by service name.
EGRESS_S3_ENDPOINT="http://moto:5000"
SQS_QUEUE_URL="http://localhost:4566/123456789012/meetai-summarize"

# Text LLM for summaries and Ask AI.
# Dev: Ollama (https://ollama.com) locally, or any Ollama/OpenAI-compatible server.
# Prod: LLM_PROVIDER="bedrock", LLM_MODEL=<Bedrock model id>, no base URL.
LLM_PROVIDER="openai_compatible"
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY="ollama"
LLM_MODEL="qwen3.5:4b"
# "none" turns off qwen3.5's thinking; leave empty for other models.
LLM_REASONING_EFFORT="none"
# Transcript chunk size for map-reduce summaries. Ollama defaults to a 4k context → 3000;
# with OLLAMA_CONTEXT_LENGTH=8192 → 6000.
LLM_MAX_INPUT_TOKENS="3000"

# Voice agent speech. Dev: the local mlx-audio server (make speech). Prod: STT_PROVIDER/TTS_PROVIDER="aws".
STT_PROVIDER="openai_compatible"
STT_BASE_URL="http://127.0.0.1:8000/v1"
STT_MODEL="mlx-community/whisper-large-v3-turbo-asr-4bit"
# Only for hosted OpenAI-compatible speech APIs (OpenAI, Groq, …); local servers ignore it.
STT_API_KEY=""
TTS_PROVIDER="openai_compatible"
TTS_BASE_URL="http://127.0.0.1:8000/v1"
TTS_MODEL="mlx-community/Kokoro-82M-bf16"
TTS_VOICE="af_heart"
TTS_API_KEY=""
